font-family = Iosevka
font-size = 10
faint-opacity = 1.0

window-width = 120
window-height = 30
window-padding-x = 0
window-padding-y = 0
window-padding-balance = true
background-opacity = 0.85
background-blur = true

window-theme = ghostty
window-titlebar-background = #222222
window-titlebar-foreground = #ffffff
gtk-wide-tabs = true
gtk-custom-css = ~/.config/ghostty/gtk.css

cursor-style = bar
cursor-style-blink = false

focus-follows-mouse = true

bell-features = no-system,no-audio,border

background = #222222
foreground = #ffffff
cursor-color = #ffffff

palette = 0=#353535
palette = 1=#e64569
palette = 2=#89d287
palette = 3=#dab752
palette = 4=#439ecf
palette = 5=#d961dc
palette = 6=#64aaaf
palette = 7=#ffffff
palette = 8=#535353
palette = 9=#e4859a
palette = 10=#a2cca1
palette = 11=#e1e387
palette = 12=#6fbbe2
palette = 13=#e586e7
palette = 14=#96dcda
palette = 15=#ffffff
