* {
    bg0: #090909;
    bg1: #232323;
    bg2: #333333;
    bg3: #4b4b4b;
    fg0: #d7d7d7;
    fg1: #939393;

    accent: #03c3d5;
    accent-muted: #637d85;
    accent-soft: #afddeb;

    warning: #ffad55;
    urgent: #e76941;
    yellow: #ebc96d;
    meter: #007383;
    blue: #3b69b5;

    background-color: transparent;
    text-color: @fg0;

    font: "Input Mono Compressed Extra-Condensed 8";
}

window {
    location: north;
    anchor: north;
    width: 760px;
    y-offset: 27px;

    background-color: @bg0;
    border: 1px;
    border-color: @bg3;
    border-radius: 0px;

    padding: 0px;
}

mainbox {
    background-color: @bg0;
    spacing: 0px;
    padding: 0px;

    children: [inputbar, message, listview];
}

inputbar {
    background-color: @bg1;
    text-color: @fg0;

    padding: 6px 8px;
    spacing: 8px;

    border: 0px 0px 1px 0px;
    border-color: @bg3;

    children: [prompt, entry];
}

prompt {
    background-color: transparent;
    text-color: @accent;
    padding: 0px;
}

entry {
    background-color: transparent;
    text-color: @fg0;
    placeholder: "Search";
    placeholder-color: @fg1;

    cursor-color: @accent;
}

message {
    background-color: @bg1;
    text-color: @warning;

    padding: 6px 8px;

    border: 0px 0px 1px 0px;
    border-color: @bg3;
}

textbox {
    background-color: transparent;
    text-color: inherit;
}

listview {
    background-color: @bg0;

    lines: 8;
    columns: 1;

    fixed-height: false;
    dynamic: true;
    cycle: false;
    scrollbar: false;

    spacing: 0px;
    padding: 0px;
}

element {
    background-color: @bg0;
    text-color: @fg0;

    padding: 5px 8px;
    spacing: 8px;

    border: 0px 0px 0px 2px;
    border-color: @bg0;
}

element alternate.normal {
    background-color: @bg0;
}

element normal.normal {
    background-color: @bg0;
    text-color: @fg0;
}

element normal.urgent {
    background-color: @bg0;
    text-color: @urgent;
}

element normal.active {
    background-color: @bg0;
    text-color: @accent-soft;
}

element selected.normal {
    background-color: @bg2;
    text-color: @fg0;
    border-color: @accent;
}

element selected.urgent {
    background-color: @urgent;
    text-color: @bg0;
    border-color: @urgent;
}

element selected.active {
    background-color: @meter;
    text-color: @fg0;
    border-color: @accent;
}

element-icon {
    background-color: transparent;
    text-color: inherit;

    size: 1em;
}

element-text {
    background-color: transparent;
    text-color: inherit;

    vertical-align: 0.5;
}

mode-switcher {
    background-color: @bg0;

    spacing: 0px;
    padding: 0px;

    border: 1px 0px 0px 0px;
    border-color: @bg3;
}

button {
    background-color: @bg0;
    text-color: @fg1;

    padding: 5px 8px;

    border: 0px 0px 2px 0px;
    border-color: @bg0;
}

button selected {
    background-color: @bg1;
    text-color: @accent;
    border-color: @accent;
}

scrollbar {
    width: 4px;
    handle-width: 4px;

    background-color: @bg1;
    handle-color: @accent-muted;

    border: 0px;
}
